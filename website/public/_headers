# Browser caching for static assets on Cloudflare Pages.
# Hashed build assets never change for a given filename → cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Demo clips are large and rarely change.
/videos/*
  Cache-Control: public, max-age=2592000

# Icons / logos: cache a week, allow revalidation.
/logo.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/favicon-48.png
  Cache-Control: public, max-age=604800
/favicon-192.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
