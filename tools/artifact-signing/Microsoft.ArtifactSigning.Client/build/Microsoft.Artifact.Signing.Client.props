<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<ArtifactSigningDlibVersion>1.0.115</ArtifactSigningDlibVersion>
		<ArtifactSigningDlibRootFolder>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</ArtifactSigningDlibRootFolder>
		<ArtifactSigningDlibBinFolder>$(ArtifactSigningDlibRootFolder)\bin</ArtifactSigningDlibBinFolder>
		<ArtifactSigningDlibBinArchFolder>$(ArtifactSigningDlibBinFolder)\x64</ArtifactSigningDlibBinArchFolder>
		<ArtifactSigningDlibFilePath>$(ArtifactSigningDlibBinArchFolder)\Azure.CodeSigning.Dlib.dll</ArtifactSigningDlibFilePath>
	</PropertyGroup>
</Project>