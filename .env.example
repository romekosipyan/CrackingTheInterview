# Desktop app — used by `npm run dev` and baked into installers when you run `npm run dist`.
OPENAI_API_KEY=sk-your-key-here

# Windows code signing (optional) — see docs/azure-artifact-signing.md
# AZURE_ARTIFACT_SIGNING_METADATA=azure-signing-metadata.json
# AZURE_ARTIFACT_SIGNING_DLIB=C:\Program Files\Microsoft Azure Artifact Signing Client Tools\x64\Azure.CodeSigning.Dlib.dll

# Legacy .pfx signing (optional; Azure metadata takes precedence if both are set)
# WIN_CSC_LINK=C:\path\to\cert.pfx
# WIN_CSC_KEY_PASSWORD=

# macOS code signing + notarization (optional) — build on macOS with npm run dist
# CSC_LINK=codesign/mac-cert.p12
# CSC_KEY_PASSWORD=
# APPLE_ID=your@email.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
