{
  "name": "cracking-the-interview",
  "version": "0.1.0",
  "description": "AI coding interview copilot desktop app",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && node scripts/pack.mjs",
    "dist": "npm run build && node scripts/pack.mjs --installer"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "i18next": "^24.2.2",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.1.1",
    "word-extractor": "^1.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.crackingtheinterview.app",
    "productName": "CrackingTheInterview",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "out/**/*"
    ],
    "icon": "resources/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
