{
  "name": "kraken-interview",
  "version": "0.1.0",
  "description": "Kraken Interview — AI interview copilot desktop app",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:record": "node scripts/dev-record.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && node scripts/pack.mjs",
    "dist": "npm run build && node scripts/pack.mjs --installer && npm run sync:downloads",
    "dev:website": "npm run dev --prefix website",
    "dev:server": "npm run dev --prefix server",
    "build:website": "npm run build --prefix website",
    "setup:stripe": "npm run setup:stripe --prefix server",
    "sync:downloads": "node scripts/sync-downloads.mjs",
    "stripe:listen": "stripe listen --forward-to localhost:4242/api/webhook --events checkout.session.completed"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "i18next": "^24.2.2",
    "mermaid": "^11.15.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.1.1",
    "word-extractor": "^1.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.krakeninterview.app",
    "productName": "Kraken Interview",
    "artifactName": "KrakenInterview.${ext}",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "out/**/*"
    ],
    "icon": "resources/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
